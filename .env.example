# ── Supabase (projet tenant courant, ou dev local) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Master (registre multi-tenant) ───────────────────────────────
# Projet Supabase dédié uniquement au registre des tenants et des admin_users.
# Ne jamais exposer côté client.
MASTER_SUPABASE_URL=
MASTER_SUPABASE_SERVICE_KEY=

# ── Domaine racine ────────────────────────────────────────────────────────
# Utilisé par le middleware pour extraire le slug sous-domaine.
NEXT_PUBLIC_ROOT_DOMAIN=pipeleads.app

# ── Anthropic (agent IA) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Notion ────────────────────────────────────────────────────────────────
# Les tokens Notion sont stockés en DB par utilisateur (table notion_config),
# pas en variable d'environnement globale.
# NOTION_INTEGRATION_TOKEN=

# ── SMTP (OVH ou autre) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cron ──────────────────────────────────────────────────────────────────
# Secret partagé entre le scheduler externe et /api/cron/daily-digest
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# ── CardDAV ───────────────────────────────────────────────────────────────
# URL interne du sync-service (Docker network ou localhost en dev)
CARDDAV_SYNC_URL=http://localhost:3001
# Secret partagé entre Next.js et le sync-service
# Générer avec : openssl rand -hex 32
CARDDAV_INTERNAL_SECRET=
# Secret HMAC pour générer les mots de passe CardDAV déterministes
# Générer avec : openssl rand -hex 32
# ⚠️  Doit être identique dans le sync-service (/opt/pipeleads-carddav/.env)
CARDDAV_PASSWORD_SECRET=
# URL publique du serveur CardDAV (pour les instructions iOS)
CARDDAV_HOST=https://carddav.pipeleads.app
